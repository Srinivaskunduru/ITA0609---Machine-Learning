# Linear Regression - Short Program

from sklearn.linear_model import LinearRegression

# Unique Dataset: Study Hours vs Test Score
X = [[1], [2], [3], [4], [5], [6]]
y = [40, 50, 58, 67, 75, 85]

model = LinearRegression()
model.fit(X, y)

print("Slope:", model.coef_[0])
print("Intercept:", model.intercept_)
print("Predicted Score for 7 Hours:", model.predict([[7]])[0])